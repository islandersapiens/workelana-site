---
import '../styles/global.css';
import fontLatin from '../assets/fonts/jakarta-latin.woff2?url';
import { JOIN_URL, CONTACT_URL, SITE_NAME } from '../config';

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | undefined;
  /** Show the fixed "Gabung" bar on small screens. */
  stickyJoin?: boolean;
}

const { title, description, ogDescription = description, ogType = 'website', jsonLd, stickyJoin = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
// Escape "<" so content can never close the JSON-LD script element.
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content="id_ID">
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:url" content={canonical}>
  <meta name="theme-color" content="#130D4F">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" href="/assets/favicon-192.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="sitemap" href="/sitemap.xml">
  <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin>
  {ld && <script type="application/ld+json" set:html={ld} />}
</head>
<body>
  <a class="skip" href="#main">Langsung ke isi</a>
  <div class="band">
    <div class="wrap">
      <header class="site-header">
        <a class="logo" href="/" aria-label="Workelana, beranda">
          <img src="/assets/logo.png" alt="Workelana" width="122" height="30">
        </a>
        <nav aria-label="Utama">
          <a href="/panduan/" aria-current={path.startsWith('/panduan/') ? 'page' : undefined}>Panduan</a>
          <a class="btn" href={JOIN_URL}>Gabung Discord</a>
        </nav>
      </header>
      <slot name="band" />
    </div>
    <slot name="band-art" />
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>Sebagian link loker adalah link referral dan selalu diberi tanda. Hasil seleksi ditentukan masing-masing platform. Workelana komunitas independen, bukan mitra resmi platform mana pun yang disebutkan.</p>
      <p>Komunitas berjalan di Discord, dan kami tidak menjual data anggota ke pihak lain. © {new Date().getFullYear()} Workelana.</p>
      <nav aria-label="Footer">
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="/panduan/">Semua panduan</a></li>
          <li><a href="/privasi/">Kebijakan privasi</a></li>
          <li><a href={CONTACT_URL}>Kontak</a></li>
        </ul>
      </nav>
    </div>
  </footer>

  {stickyJoin && <div class="sticky"><a class="btn" href={JOIN_URL}>Gabung Discord gratis</a></div>}
</body>
</html>
