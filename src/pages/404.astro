  noindex
>
  <div class="page-head" slot="band">
    <h1>Halaman tidak ditemukan</h1>
    <p class="lead">Halaman ini tidak ada atau sudah dipindah.</p>
  </div>
  <div class="band-sun" slot="band-art" aria-hidden="true"></div>

  <section class="sec">
    <div class="wrap">
      <p class="cta-row"><a class="btn" href="/">Kembali ke beranda</a> <a href="/panduan/">Lihat semua panduan</a></p>
    </div>
  </section>
</Base>
