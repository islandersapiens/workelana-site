---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import JobTickets from '../components/home/JobTickets.astro';
import Photos from '../components/home/Photos.astro';
import ServerCategories from '../components/home/ServerCategories.astro';
import JoinSteps from '../components/home/JoinSteps.astro';
import Rules from '../components/home/Rules.astro';
import GuidePreview from '../components/home/GuidePreview.astro';
import Faq from '../components/home/Faq.astro';
import ShareBand from '../components/home/ShareBand.astro';
import { faqs } from '../data/home';
import { ORG, ORG_REF, SITE_NAME, SITE_URL } from '../config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG,
    { '@type': 'WebSite', '@id': `${SITE_URL}#website`, name: SITE_NAME, url: SITE_URL, inLanguage: 'id', publisher: ORG_REF },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};
---
<Base
  jsonLd={jsonLd}
  title="Loker Remote Indonesia & AI Annotation | Komunitas Workelana"
  description="Komunitas gratis untuk cari kerja remote dari Indonesia: loker remote, AI annotation, tips lolos tes, dan review platform. Gabung Discord Workelana."
  ogDescription="Loker remote, tips lolos tes, dan review platform dari sesama pencari kerja Indonesia. Gratis."
  stickyJoin
>
  <Hero slot="band" />
  <JobTickets />
  <Photos />
  <ServerCategories />
  <JoinSteps />
  <Rules />
  <GuidePreview />
  <Faq />
  <ShareBand />
</Base>
