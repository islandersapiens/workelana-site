---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntries, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import GuideCard from '../../components/GuideCard.astro';
import PromoCard from '../../components/PromoCard.astro';
import { formatDate, isoDate } from '../../lib/date';
import { OG_IMAGE, ORG, ORG_REF, SITE_URL } from '../../config';

export const getStaticPaths = (async () => {
  const guides = await getCollection('panduan');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}) satisfies GetStaticPaths;

const { guide } = Astro.props;
const { Content } = await render(guide);
const related = await getEntries(guide.data.related);
const url = new URL(`/panduan/${guide.id}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG,
    {
      '@type': 'Article',
      headline: guide.data.title,
      description: guide.data.description,
      image: new URL(OG_IMAGE, Astro.site).href,
      datePublished: isoDate(guide.data.published),
      dateModified: isoDate(guide.data.updated),
      inLanguage: 'id',
      author: ORG_REF,
      publisher: ORG_REF,
      mainEntityOfPage: url,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Panduan', item: `${SITE_URL}panduan/` },
        { '@type': 'ListItem', position: 3, name: guide.data.title, item: url },
      ],
    },
  ],
};
---
<Article
  title={guide.data.title}
  seoTitle={guide.data.seoTitle}
  description={guide.data.description}
  meta={`Diperbarui ${formatDate(guide.data.updated)} oleh Tim Workelana`}
  crumb={{ href: '/panduan/', label: 'Semua panduan' }}
  jsonLd={jsonLd}
>
  <Content />
  <Fragment slot="end">
    <PromoCard title={guide.data.cta.title} text={guide.data.cta.text} />
    {related.length > 0 && (
      <section aria-labelledby="related-h">
        <h2 id="related-h">Baca juga</h2>
        <ul class="cards">
          {related.map((r) => (
            <li><GuideCard guide={r} /></li>
          ))}
        </ul>
      </section>
    )}
  </Fragment>
</Article>
